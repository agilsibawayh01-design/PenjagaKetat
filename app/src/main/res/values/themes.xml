<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:colorAccent">#D4AF6A</item>
        <item name="android:colorControlActivated">#D4AF6A</item>
        <item name="android:colorControlNormal">#8A8576</item>
        <item name="android:windowBackground">#0A0C10</item>
        <item name="android:editTextBackground">@drawable/lux_input</item>
        <item name="android:textColorHint">#7C7768</item>
        <item name="android:alertDialogTheme">@style/LuxDialog</item>
        <item name="android:windowSplashScreenBackground">#0A0C10</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
    <style name="AppThemeLight" parent="android:Theme.DeviceDefault.Light">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:colorAccent">#8A6420</item>
        <item name="android:colorControlActivated">#8A6420</item>
        <item name="android:colorControlNormal">#756D5D</item>
        <item name="android:windowBackground">#F6F2E9</item>
        <item name="android:editTextBackground">@drawable/lux_input_light</item>
        <item name="android:textColorHint">#857D6C</item>
        <item name="android:alertDialogTheme">@style/LuxDialogLight</item>
    </style>
    <style name="LuxDialogLight" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/lux_dialog_bg_light</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:colorAccent">#8A6420</item>
        <item name="android:colorControlActivated">#8A6420</item>
        <item name="android:editTextBackground">@drawable/lux_input_light</item>
        <item name="android:textColorHint">#857D6C</item>
    </style>
    <style name="LuxDialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/lux_dialog_bg</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:colorAccent">#D4AF6A</item>
        <item name="android:colorControlActivated">#D4AF6A</item>
        <item name="android:editTextBackground">@drawable/lux_input</item>
        <item name="android:textColorHint">#7C7768</item>
    </style>
</resources>
